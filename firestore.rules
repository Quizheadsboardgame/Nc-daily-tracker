rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated users (including anonymous sales terminals) can read and write sales
    match /sales/{saleId} {
      allow read, write: if request.auth != null;
    }
    // Salesmen roster records
    match /salesmen/{salesmanId} {
      allow read, write: if request.auth != null;
    }
  }
}
