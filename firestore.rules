rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sales transaction records accessible by all terminals
    match /sales/{saleId} {
      allow read, write: if true;
    }
    // Salesmen roster records synced across all terminals
    match /salesmen/{salesmanId} {
      allow read, write: if true;
    }
    // Trade records and trade-in items synced across all terminals
    match /trades/{tradeId} {
      allow read, write: if true;
    }
    // Preloaded vendor stock and cards synced across all terminals
    match /stock/{stockId} {
      allow read, write: if true;
    }
    // Online cards and barcodes synced across all terminals
    match /online_cards/{cardId} {
      allow read, write: if true;
    }
    // General inventory collection synced across all terminals
    match /inventory/{itemId} {
      allow read, write: if true;
    }
    // Removed vendors list to synchronize vendor deletions across all devices
    match /removed_vendors/{vendorId} {
      allow read, write: if true;
    }
    // End-of-day cash drawer reconciliations synced across terminals
    match /cash_reconciliations/{dateKey} {
      allow read, write: if true;
    }
    // Customer store credit accounts & balances synced across terminals
    match /store_credit_customers/{customerId} {
      allow read, write: if true;
    }
    // Customer store credit transaction audit log synced across terminals
    match /store_credit_transactions/{txId} {
      allow read, write: if true;
    }
    // Customer holds, deposits & layaway records synced across terminals
    match /holds/{holdId} {
      allow read, write: if true;
    }
    // Market gift cards & balances synced across terminals
    match /gift_cards/{cardId} {
      allow read, write: if true;
    }
    // Gift card transaction audit log synced across terminals
    match /gift_card_transactions/{txId} {
      allow read, write: if true;
    }
    // Universal access rule to ensure all devices can read and write all application data
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
