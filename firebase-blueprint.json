{
  "entities": {
    "Sale": {
      "title": "Sale",
      "description": "Recorded sales transaction item in the ledger",
      "type": "object",
      "properties": {
        "salesmanName": {
          "type": "string",
          "description": "Vendor name recording the sale"
        },
        "itemDescription": {
          "type": "string",
          "description": "Description of item sold"
        },
        "amount": {
          "type": "number",
          "description": "Sale value in GBP"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash", "card", "trade"],
          "description": "Payment method used for transaction"
        },
        "tradeDetails": {
          "type": "string",
          "description": "Combined trade-in exchange summary and terms"
        },
        "tradeAcceptingVendor": {
          "type": "string",
          "description": "Vendor accepting the trade-in item"
        },
        "tradeValue": {
          "type": "number",
          "description": "Valuation in GBP of the traded-in item"
        },
        "tradeItemDescription": {
          "type": "string",
          "description": "Description of the traded-in item"
        },
        "notes": {
          "type": "string",
          "description": "Optional notes or receipt memo"
        },
        "timestamp": {
          "type": "number",
          "description": "Transaction timestamp in epoch milliseconds"
        },
        "dateKey": {
          "type": "string",
          "description": "Calendar date string in YYYY-MM-DD format"
        }
      },
      "required": ["salesmanName", "itemDescription", "amount", "paymentMethod", "timestamp", "dateKey"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Registered active vendor in the team roster",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Vendor full name"
        },
        "color": {
          "type": "string",
          "description": "Assigned theme color hex code for the vendor"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp when added"
        }
      },
      "required": ["name"]
    },
    "Trade": {
      "title": "Trade",
      "description": "Recorded trade-in transaction or exchange item",
      "type": "object",
      "properties": {
        "vendorName": {
          "type": "string",
          "description": "Vendor accepting or taking in the trade"
        },
        "itemDescription": {
          "type": "string",
          "description": "Description of the traded-in item"
        },
        "tradeValue": {
          "type": "number",
          "description": "Valuation in GBP of the traded item"
        },
        "isStandalone": {
          "type": "boolean",
          "description": "Whether the trade is standalone or against a sale"
        },
        "soldItemDescription": {
          "type": "string",
          "description": "Description of item sold against this trade if applicable"
        },
        "saleAmount": {
          "type": "number",
          "description": "Sale amount if applicable"
        },
        "associatedSaleId": {
          "type": "string",
          "description": "ID of associated sale transaction if applicable"
        },
        "customerName": {
          "type": "string",
          "description": "Optional customer name or details"
        },
        "notes": {
          "type": "string",
          "description": "Optional notes or terms"
        },
        "timestamp": {
          "type": "number",
          "description": "Epoch timestamp in milliseconds"
        },
        "dateKey": {
          "type": "string",
          "description": "Date string YYYY-MM-DD"
        }
      },
      "required": ["vendorName", "itemDescription", "tradeValue", "timestamp", "dateKey"]
    }
  },
  "firestore": {
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Collection of all sales ledger records across terminals"
    },
    "/salesmen/{salesmanId}": {
      "schema": "Vendor",
      "description": "Collection of team vendors roster across terminals"
    },
    "/trades/{tradeId}": {
      "schema": "Trade",
      "description": "Collection of trade records and trade-in items"
    }
  }
}
