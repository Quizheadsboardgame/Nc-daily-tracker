{
  "entities": {
    "Sale": {
      "title": "Sale",
      "description": "Recorded sales transaction item in the ledger",
      "type": "object",
      "properties": {
        "salesmanName": {
          "type": "string",
          "description": "Vendor name recording the sale"
        },
        "itemDescription": {
          "type": "string",
          "description": "Description of item sold"
        },
        "amount": {
          "type": "number",
          "description": "Sale value in GBP"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash", "card", "trade"],
          "description": "Payment method used for transaction"
        },
        "tradeDetails": {
          "type": "string",
          "description": "Combined trade-in exchange summary and terms"
        },
        "tradeAcceptingVendor": {
          "type": "string",
          "description": "Vendor accepting the trade-in item"
        },
        "tradeValue": {
          "type": "number",
          "description": "Valuation in GBP of the traded-in item"
        },
        "tradeItemDescription": {
          "type": "string",
          "description": "Description of the traded-in item"
        },
        "notes": {
          "type": "string",
          "description": "Optional notes or receipt memo"
        },
        "timestamp": {
          "type": "number",
          "description": "Transaction timestamp in epoch milliseconds"
        },
        "dateKey": {
          "type": "string",
          "description": "Calendar date string in YYYY-MM-DD format"
        }
      },
      "required": ["salesmanName", "itemDescription", "amount", "paymentMethod", "timestamp", "dateKey"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Registered active vendor in the team roster",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Vendor full name"
        },
        "color": {
          "type": "string",
          "description": "Assigned theme color hex code for the vendor"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp when added"
        }
      },
      "required": ["name"]
    }
  },
  "firestore": {
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Collection of all sales ledger records across terminals"
    },
    "/salesmen/{salesmanId}": {
      "schema": "Vendor",
      "description": "Collection of team vendors roster across terminals"
    }
  }
}
